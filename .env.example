# Copy this file to .env and fill in your own values. .env is gitignored.

# Groq API key (https://console.groq.com/keys)
GROQ_API_KEY=

# Optional: extra comma-separated Groq API keys (e.g. from separate free-tier accounts) to
# round-robin and fail over across. Each key has its own daily quota, so 2 keys ~doubles both
# throughput and how much you can process before hitting a quota wall. Leave blank if you only have one.
GROQ_API_KEYS=

# Text model used for fact extraction, normalization hints, and relationship reasoning.
# Run `python scripts/list_groq_models.py` after setting GROQ_API_KEY to see what your account can access.
GROQ_TEXT_MODEL=openai/gpt-oss-120b

# Vision-capable model used for chart/figure/image evidence extraction. Not every Groq account/tier
# exposes a vision model (meta-llama/llama-4-scout-17b-16e-instruct and .../llama-4-maverick-17b-128e-instruct
# are the usual ones) - if yours doesn't, leave this as-is; the pipeline logs a clear extraction_issue and
# falls back to whatever plain text is embedded on the page instead of failing the whole page.
GROQ_VISION_MODEL=meta-llama/llama-4-scout-17b-16e-instruct

# Local sentence-transformers model for embeddings (downloaded on first run)
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5

# SQLite database file
DATABASE_PATH=data/fact_layer.db

# Chroma persistence directory
CHROMA_DIR=data/chroma
