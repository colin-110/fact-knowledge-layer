# Copy this file to .env and fill in your own values. .env is gitignored.

# Groq API key (https://console.groq.com/keys)
GROQ_API_KEY=

# Text model used for fact extraction, normalization hints, and relationship reasoning
GROQ_TEXT_MODEL=llama-3.3-70b-versatile

# Vision-capable model used for chart/figure/image evidence extraction
GROQ_VISION_MODEL=meta-llama/llama-4-scout-17b-16e-instruct

# Local sentence-transformers model for embeddings (downloaded on first run)
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5

# SQLite database file
DATABASE_PATH=data/fact_layer.db

# Chroma persistence directory
CHROMA_DIR=data/chroma
